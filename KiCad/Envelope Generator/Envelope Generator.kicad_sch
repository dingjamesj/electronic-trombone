	(text "The filter requires a noninverted signal from 0V to 1.2V."
		(exclude_from_sim no)
		(at 255.27 102.87 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "0797ea0b-8731-473e-8218-d7e1553c7363")
	)
	(text "Simulated resistance = 100k"
		(exclude_from_sim no)
		(at 180.086 78.232 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "0d064702-87dc-445a-a960-a0cca2048705")
	)
	(text "Simulated resistance = 150k each"
		(exclude_from_sim no)
		(at 51.054 128.524 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "1a770dd8-af8a-482c-ae33-7624205ae705")
	)
	(text "Simulated ref.: 4.5V"
